# Cubemoons Audit Generator — Environment Variables
# Copy this file to .env and fill in your keys

# ── OpenAI ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.3

# ── Search API (pick one) ──────────────────────────────────────────────────────
# Option A: Serper (Google Search) — https://serper.dev  (recommended)
SERPER_API_KEY=

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── PDF ────────────────────────────────────────────────────────────────────────
PDF_OUTPUT_DIR=./generated_pdfs

# ── Research ───────────────────────────────────────────────────────────────────
MAX_RESEARCH_TIMEOUT=30
